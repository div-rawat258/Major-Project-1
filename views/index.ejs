<% layout('layouts/boilerplate.ejs') -%> 

    
 <h2> Hotel List: </h2>

<div class="row  row-cols-lg-3  row-cols-md-2 row-cols-sm-1">
 <% for(let listing of allListings) {%>
  <a href="/listings/<%= listing._id %>" class="listing-link">
   <div class="card col listing-card" >
  <% const imageUrl = listing.image && typeof listing.image === 'object' ? listing.image.url : listing.image; %>
  <img src="<%= imageUrl %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
  <div class="card-img-overlay"> abc</div>
  <div class="card-body">
    <p class="card-text">
    <b> <%= listing.title %></b> </br> 
&#8377; <%= listing.price %>/night
</p>
  </div>
</div>
  </a>
            <%}%> 
</div>

