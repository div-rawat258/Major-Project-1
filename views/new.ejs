<% layout('layouts/boilerplate.ejs') -%>
   <div class="row mt-3">
<div class="col-8 offset-2">
          <!-- <br></br> -->

    <h3>Create a next Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation">
       <div  class="mb-3">
    <label for="title" class="form-label">Title</label>
        <input name="listing[title]" placeholder="Add the catchy title" class="form-control"
        required
        >
        <div class="valid-feedback">title is good</div>
       </div>
        <div  class="mb-3">
              <label for="description" class="form-label">description</label>

  <textarea name="listing[description]"  class="form-control" required ></textarea>
        <div class="invalid-feedback"> please enter a short </div>
        </div>
        <div  class="mb-3">
               <label for="image" class="form-label">Image</label>
          <input name="listing[image]" placeholder="enter the image url/link" type="text"  class="form-control">
        </div>

        <div class="row">  
        <div  class="mb-3 col-md-4" >
        <label for="price" class="form-label">price</label>
        <input name="listing[price]" placeholder="1200" type="number"  class="form-control" required>
        <div class="invalid-feedback">price required</div>
        </div>
     <div  class="mb-3 col-md-8">   
     <label for="country" class="form-label">country</label>
   <input name="listing[country]" placeholder="India" type="text"  class="form-control" required>
     <div class="invalid-feedback">country required</div>
</div>
</div>

 <div  class="mb-3">
    <label for="location" class="form-label">location</label>
    <input name="listing[location]" placeholder="pauri,Uttarkhand" type="text"  class="form-control" required>
    <div class="invalid-feedback">location required</div>
</div>
    
        <br></br>
        <button class="btn btn-dark add-btn">Add Listing</button>
    </div>

    <br>
</form>